<?xml version="1.0" encoding="utf-8"?>
<!--
    적응형 아이콘 전경 — 잎(전기차) + OBD 커넥터 플러그.

    적응형 아이콘은 108x108 중 가운데 72x72(18~90) 만 항상 보인다.
    런처가 원·사각·물방울 등으로 잘라 내므로 모든 요소를 이 안전 영역에 넣었다.

    같은 드로어블이 monochrome 으로도 쓰이므로 색이 아니라 형태로 알아볼 수 있게 그렸다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 잎 본체 -->
    <path
        android:fillColor="#8CD9A8"
        android:pathData="M32,70 C32,46 46,28 76,24 C78,52 62,70 32,70 Z" />

    <!-- 잎맥 -->
    <path
        android:strokeColor="#12503A"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M33,69 L74,26" />

    <!-- OBD 커넥터 몸체 -->
    <path
        android:fillColor="#E6F4EC"
        android:pathData="M47,72 h14 a3,3 0 0 1 3,3 v7 a3,3 0 0 1 -3,3 h-14 a3,3 0 0 1 -3,-3 v-7 a3,3 0 0 1 3,-3 z" />

    <!-- 커넥터 핀 2개 -->
    <path
        android:fillColor="#12503A"
        android:pathData="M49,76 h3 v5 h-3 z M56,76 h3 v5 h-3 z" />
</vector>
